{
  "schemaVersion": 1,
  "lockedRegions": {
    "controlPlane": "ap-southeast-2",
    "analytical": "ap-southeast-2",
    "storage": "ap-southeast-2",
    "modelDataResidency": "au"
  },
  "runtimes": {
