# syntax=docker/dockerfile:1.7

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=albert-capacity-build-npm,target=/root/.npm,sharing=locked npm ci --ignore-scripts
COPY . .
RUN node scripts/build-capacity-attestor.mjs

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=albert-capacity-runtime-npm,target=/root/.npm,sharing=locked npm ci --omit=dev --ignore-scripts \
  && npm cache clean --force
COPY --from=build --chown=node:node /workspace/.albert-build/capacity-attestor ./capacity-attestor
USER node
CMD ["node", "--enable-source-maps", "capacity-attestor/main.js"]
