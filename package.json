{
  "name": "albert",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:codex-runtime": "PORT=8792 ALBERT_CODEX_MAX_CONCURRENT_TURNS=4 node --env-file=.env.local --import tsx --watch services/codex-runtime/src/main.ts",
    "dev:codex-runtime:subscription": "PORT=8799 ALBERT_CODEX_AUTH_MODE=chatgpt ALBERT_CODEX_MAX_CONCURRENT_TURNS=4 node --env-file=.env.local --import tsx services/codex-runtime/src/main.ts",
    "dev:oauth-worker": "tsx services/sync-workers/src/oauth-only-main.ts",
    "dev:xero-mcp": "tsx scripts/xero-mcp-service.mts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:services": "node scripts/build-services.mjs",
    "build:capacity-attestor": "node scripts/build-capacity-attestor.mjs",
    "build:vendor-connection-attestor": "node scripts/build-vendor-connection-attestor.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:contracts && npm run test:evals && npm run test:service-build && npm run build && node --test tests/rendered-html.test.mjs",
    "test:contracts": "node --import tsx --test tests/contracts/*.test.ts packages/queue/queue.test.ts packages/storage/raw-batch.test.ts packages/fivetran/fivetran.test.ts services/capacity-attestor/*.test.ts services/vendor-connection-attestor/*.test.ts services/codex-runtime/*.test.ts services/imessage-bridge/*.test.ts services/deletion-worker/src/*.test.ts services/sync-workers/*.test.ts services/webhook-gateway/*.test.ts tests/runtime-foundation.test.mjs tests/security-foundation.test.mjs tests/conversation-grounding.test.mjs tests/usage-metering.test.mjs tests/vercel-runtime.test.mjs tests/release-authority.test.mjs tests/release-authorization-receipt.test.mjs tests/release-plan.test.mjs tests/release-preflight.test.mjs tests/release-readiness.test.mjs tests/production-environment-audit.test.mjs tests/supabase-auth-production-policy.test.mjs",
    "test:evals": "node --import tsx --test evals/*.test.ts",
    "test:service-build": "npm run build:services && npm run build:capacity-attestor && npm run build:vendor-connection-attestor && node scripts/check-service-boundaries.mjs && node --check .albert-build/services/sync-worker.js && node --check .albert-build/services/deletion-worker.js && node --check .albert-build/services/webhook-gateway.js && node --check .albert-build/services/operator-diagnostic.js && node --check .albert-build/services/codex-runtime.js && node --check .albert-build/services/imessage-bridge.js && node --check .albert-build/capacity-attestor/main.js && node --check .albert-build/vendor-connection-attestor/main.js",
    "test:deployment": "node scripts/validate-deployment.mjs",
    "test:analytical-capability-boundary": "tsx scripts/test-analytical-capability-boundary.ts",
    "test:raw-storage-s3-session": "tsx scripts/test-raw-storage-s3-session.ts",
    "test:browser": "node scripts/run-browser-acceptance.mjs",
    "eval:codex:subscription300": "node --import tsx scripts/albert-eval/run-codex.mts --run codex-subscription-luna-max-fast-300 --corpus subscription300 --auth chatgpt --transport in-process --model gpt-5.6-luna --effort max --fast --concurrency 4 --worker-stagger-ms 2500 --resume",
    "eval:codex:subscription-grade": "node --import tsx scripts/albert-eval/grade-codex-subscription.mts --run codex-subscription-luna-max-fast-300 --batch-size 4 --concurrency 2 --resume",
    "eval:codex:subscription-report": "node --import tsx scripts/albert-eval/report.mts --run codex-subscription-luna-max-fast-300",
    "eval:codex:subscription-verify": "node --import tsx scripts/albert-eval/verify-codex-subscription-run.mts --run codex-subscription-luna-max-fast-300",
    "eval:codex:subscription-loop": "npm run eval:codex:subscription300 && npm run eval:codex:subscription-grade && npm run eval:codex:subscription-report && npm run eval:codex:subscription-verify",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:authority": "node scripts/assert-release-authority.mjs",
    "audit:production-environment": "node scripts/audit-production-environment.mjs",
    "provenance:vercel": "node scripts/collect-vercel-platform-provenance.mjs",
    "verify:xero-pnl-production": "node --import tsx scripts/verify-xero-pnl-production.mts",
    "typecheck": "tsc --noEmit",
    "check": "npm run prompt-docs:check && npm run albert-v3-agent-config:check && npm run test:deployment && npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern scripts/.probe",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap:upgrade:control-plane": "tsx scripts/admin-bootstrap-upgrades.ts",
    "provision:runtime-logins": "tsx scripts/provision-runtime-logins.ts",
    "provision:vendor-connection-attestor": "tsx scripts/provision-vendor-connection-attestor.ts",
    "provision:analytical-capability-key": "tsx scripts/provision-analytical-capability-key.ts",
    "provision:webhook-attestation-key": "tsx scripts/provision-webhook-attestation-key.ts",
    "provision:raw-storage-machine-users": "tsx scripts/provision-raw-storage-machine-users.ts",
    "generate:albert-v3-agent-config": "tsx scripts/generate-albert-v3-agent-config.mts",
    "albert-v3-agent-config:check": "tsx scripts/generate-albert-v3-agent-config.mts --check",
    "generate:connector-staging": "tsx scripts/generate-connector-staging.ts",
    "generate:connector-playbooks": "tsx scripts/write-connector-playbook-doc.mts",
    "generate:staging-schema": "tsx scripts/write-staging-schema-doc.mts",
    "shopify:schema:generate": "tsx scripts/generate-shopify-admin-schema-registry.mts",
    "shopify:schema:check": "tsx scripts/generate-shopify-admin-schema-registry.mts --check",
    "shopify:queries:check": "tsx scripts/check-shopify-admin-queries.mts",
    "test:shopify:schema": "node --import tsx --test tests/contracts/shopify-schema-registry.contract.test.ts",
    "shopifyql:schema:generate": "tsx scripts/generate-shopifyql-schema-registry.mts",
    "shopifyql:schema:check": "tsx scripts/generate-shopifyql-schema-registry.mts --check",
    "test:shopifyql:schema": "node --import tsx --test tests/contracts/shopifyql-schema-registry.contract.test.ts",
    "prompt-docs:check": "tsx scripts/write-connector-playbook-doc.mts --check && tsx scripts/write-staging-schema-doc.mts --check",
    "connector-pack:activate": "tsx scripts/activate-connector-pack.ts",
    "connector-pack:retire-connection": "tsx scripts/retire-connector-pack-connection.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@anthropic-ai/sdk": "0.116.0",
    "@aws-sdk/client-bedrock": "3.1106.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@openai/codex": "0.148.0",
    "@openai/agents": "^0.14.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "flint-chart": "^0.5.1",
    "framer-motion": "^12.43.0",
    "js-yaml": "4.3.1",
    "kysely": "^0.29.4",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "postprocessing": "^6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "2.2.3",
    "thinking-orbs": "^0.2.0",
    "three": "^0.185.1",
    "ulid": "^3.0.2",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-interpreter": "^2.2.1",
    "vega-lite": "^6.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.3.0",
    "js-tiktoken": "1.0.21",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.1"
  },
  "type": "module"
}
