{
  "name": "albert",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:services": "node scripts/build-services.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:contracts && npm run test:evals && npm run test:service-build && npm run build && node --test tests/rendered-html.test.mjs",
    "test:contracts": "node --import tsx --test tests/contracts/*.test.ts services/sync-workers/credential-refresh-lease.test.ts tests/runtime-foundation.test.mjs tests/runtime-health.test.mjs tests/security-foundation.test.mjs tests/conversation-grounding.test.mjs tests/usage-metering.test.mjs tests/semantic-publication.test.mjs",
    "test:evals": "node --import tsx --test evals/*.test.ts",
    "test:service-build": "npm run build:services && node scripts/check-service-boundaries.mjs && node --check .albert-build/services/sync-worker.js && node --check .albert-build/services/transform-worker.js && node --check .albert-build/services/deletion-worker.js && node --check .albert-build/services/webhook-gateway.js && node --check .albert-build/services/semantic-query.js",
    "test:deployment": "node scripts/validate-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run registry:check && npm run test:deployment && npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "migrate": "tsx scripts/migrate.ts",
    "provision:runtime-logins": "tsx scripts/provision-runtime-logins.ts",
    "generate:connector-staging": "tsx scripts/generate-connector-staging.ts",
    "registry:check": "tsx scripts/registry.ts check",
    "registry:write": "tsx scripts/registry.ts write",
    "registry:publish": "tsx scripts/registry.ts publish"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@openai/agents": "^0.14.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "^12.43.0",
    "next": "16.2.12",
    "openai": "^7.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "type": "module"
}
