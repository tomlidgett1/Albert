# Browser-visible Supabase control-plane settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only OpenAI runtime. Production enablement also requires the approved
# Australian inference/data-residency decision recorded in ADR 0001.
OPENAI_API_KEY=
# Keep `fixture` until the regional endpoint and semantic-service deployment are approved.
ALBERT_CONVERSATION_RUNTIME=fixture

# Server-only databases. The analytical host is intentionally unset until the
# provider decision in the founding specification is resolved.
CONTROL_PLANE_DATABASE_URL=
ANALYTICAL_DATABASE_URL=

# Connector OAuth registrations. Never expose client secrets to the browser.
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
DEPUTY_CLIENT_ID=
DEPUTY_CLIENT_SECRET=
