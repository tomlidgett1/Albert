# Browser-visible Supabase settings. Production must be a Sydney project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ALBERT_CONTROL_PLANE_PROJECT_REF=
ALBERT_CONTROL_PLANE_REGION=ap-southeast-2
ALBERT_ANALYTICAL_REGION=ap-southeast-2

# Sites web runtime. The AU endpoint provides regional storage; the OpenAI
# project must separately be approved for MAM or ZDR before customer data use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://au.api.openai.com/v1
ALBERT_MODEL_DATA_RESIDENCY_REGION=au
# Set true only after the production OpenAI project has approved MAM or ZDR.
ALBERT_MODEL_DATA_CONTROL_APPROVED=false
ALBERT_CONVERSATION_RUNTIME=live
ALBERT_ALLOW_FIXTURE_RUNTIME=false
ALBERT_OPENAI_TRACING_ENABLED=false
ALBERT_TURN_TIMEOUT_MS=180000
ALBERT_EMBEDDING_TIMEOUT_MS=20000
ALBERT_USER_HASH_SECRET=
ALBERT_PUBLIC_ORIGIN=

# Independent trust-zone secrets (at least 32 random bytes). The web and the
# corresponding service receive only the one secret they share.
ALBERT_OAUTH_STATE_SECRET=
ALBERT_OAUTH_WORKER_SIGNING_SECRET=
ALBERT_SEMANTIC_SIGNING_SECRET=
ALBERT_OPERATOR_DIAGNOSTIC_SIGNING_SECRET=

# HTTPS endpoints for separately deployed services. OAuth and semantic routes
# require HMAC. Xero registers the webhook URL at app level; an owner/operator
# may install the optional Deputy callback manually. OAuth never installs it.
SYNC_WORKER_INTERNAL_URL=
SEMANTIC_QUERY_SERVICE_URL=
OPERATOR_DIAGNOSTIC_SERVICE_URL=
WEBHOOK_GATEWAY_PUBLIC_URL=

# Process-specific database URLs. Deployments may use the same variable name,
# but each value must contain the dedicated NOINHERIT login documented below.
# sync:      albert_sync_control_runtime -> albert_sync_control
# webhook:   albert_webhook_control_runtime -> albert_webhook_control
# semantic:  albert_semantic_control_runtime -> albert_semantic_control
# deletion:  albert_deletion_control_runtime -> albert_deletion_control
CONTROL_PLANE_DATABASE_URL=
# sync: albert_ingest_runtime -> ingest_rw
# semantic: albert_semantic_read_runtime -> semantic_ro
ANALYTICAL_DATABASE_URL=
# transform control and analytical logins are deliberately named separately.
TRANSFORM_CONTROL_PLANE_DATABASE_URL=
TRANSFORM_DATABASE_URL=
# semantic metadata is a second analytical login, member only of semantic_meta_rw.
ALBERT_SEMANTIC_METADATA_DATABASE_URL=
# deletion analytical login, member only of deletion_rw.
DELETION_ANALYTICAL_DATABASE_URL=
# Dedicated operator diagnostic URLs. These credentials belong only to the
# signed row-sample service and must never be configured in Sites.
OPERATOR_DIAGNOSTIC_CONTROL_PLANE_DATABASE_URL=
OPERATOR_DIAGNOSTIC_ANALYTICAL_DATABASE_URL=

# Independent capacity-attestor trust deployment only. These values never
# belong in Sites, Albert Fly apps, or candidate release CI. See
# docs/independent-capacity-attestor.md.
ALBERT_CAPACITY_ALLOWED_REPOSITORY=
ALBERT_CAPACITY_ALLOWED_WORKFLOW_REF=
ALBERT_CAPACITY_ALLOWED_RELEASE_REF=
ALBERT_CAPACITY_STAGING_CELL_ID=
ALBERT_CAPACITY_TRANSFORM_APP=
ALBERT_CAPACITY_AUTOSCALER_APP=
ALBERT_CAPACITY_REQUESTED_FLOOR=2
ALBERT_CAPACITY_CORPUS_FINGERPRINT=
ALBERT_CAPACITY_ATTESTOR_TOOL_REF=
ALBERT_CAPACITY_ATTESTOR_BUILD_DIGEST=
ALBERT_CAPACITY_PROMETHEUS_ORIGIN=
ALBERT_CAPACITY_PROMETHEUS_RUNNING_QUERY=
ALBERT_CAPACITY_PROMETHEUS_DESIRED_QUERY=
ALBERT_CAPACITY_ED25519_PRIVATE_KEY_BASE64=
ALBERT_CAPACITY_ATTESTOR_STORE_DATABASE_URL=
ALBERT_CAPACITY_CONTROL_OBSERVER_DATABASE_URL=
ALBERT_CAPACITY_ANALYTICAL_OBSERVER_DATABASE_URL=
ALBERT_CAPACITY_GITHUB_READ_TOKEN=
ALBERT_CAPACITY_FLY_READ_TOKEN=
ALBERT_CAPACITY_PROMETHEUS_READ_TOKEN=

# Deployment-only semantic publisher. Never configure this role in a runtime.
ALBERT_SEMANTIC_PUBLISH_ROLE=albert_control_migration_owner

# Supabase Storage S3 session coordinates. Generated S3 key pairs are forbidden:
# they bypass RLS. In production the access key ID is the project ref and the
# secret key is the legacy anon JWT (publishable keys are not S3-compatible).
# Each service receives only its own protected machine password; the provider
# exchanges it for a short-lived JWT and refreshes that session in memory.
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_S3_REGION=ap-southeast-2
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_LEGACY_ANON_KEY=
ALBERT_RAW_STORAGE_SYNC_PASSWORD=
ALBERT_RAW_STORAGE_WEBHOOK_PASSWORD=
ALBERT_RAW_STORAGE_DELETION_PASSWORD=

# Protected release provisioner only. Never stage these names in Sites or Fly.
SUPABASE_AUTH_URL=
SUPABASE_AUTH_ADMIN_SERVICE_ROLE_KEY=
ALBERT_RAW_STORAGE_CREDENTIAL_GENERATION=

# Stable worker role identities. Every service automatically appends Fly's
# machine ID; non-Fly orchestrators must set ALBERT_WORKER_INSTANCE_ID uniquely
# per replica so lease fencing remains safe when services scale horizontally.
ALBERT_WORKER_ID=
ALBERT_WORKER_INSTANCE_ID=
ALBERT_WORKER_CONCURRENCY=8
ALBERT_QUEUE_SLA_SECONDS=300
ALBERT_METRICS_PORT=9091
ALBERT_MAPPING_VERSION=m2-v1
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=
# Optional decrypt-only overlap keyring shared by sync/OAuth and deletion
# runtimes during KEK rotation. Canonical JSON, at most four distinct entries:
# {"token-v1":"<canonical-unpadded-base64url-32-byte-key>"}
TOKEN_PREVIOUS_ENCRYPTION_KEYS=

# Transform worker identity.
ALBERT_TRANSFORM_WORKER_ID=
# Transform deployments use the same bounded concurrency/metrics settings,
# with a 120-second queue SLO and a drain-to-empty hourly tenant sweep.
ALBERT_SNAPSHOT_CLAIM_BATCH_SIZE=8
ALBERT_SNAPSHOT_MAX_CLAIMS_PER_RUN=20000

# Semantic promotion relay identity and bounded recovery controls. The source
# exploration request returns only after the corresponding inbox delivery is
# durably acknowledged; this loop recovers outbox rows after process loss.
ALBERT_SEMANTIC_RELAY_WORKER_ID=semantic-promotion-relay
ALBERT_SEMANTIC_RELAY_POLL_INTERVAL_MS=5000
ALBERT_SEMANTIC_RELAY_TENANT_BATCH_SIZE=10
ALBERT_SEMANTIC_RELAY_CANDIDATE_BATCH_SIZE=20
ALBERT_SEMANTIC_RELAY_LEASE_SECONDS=90

# Public webhook gateway background processor role identity.
ALBERT_WEBHOOK_WORKER_ID=

# Deletion worker identity and proof-authentication key.
ALBERT_DELETION_WORKER_ID=
DELETION_PROOF_HMAC_KEY=
DELETION_WORKER_POLL_MS=1000

# Non-secret deployment identity set automatically by the release workflow.
# ALBERT_BUILD_SHA is a build input for Sites and Fly service images. It is
# compiled into every bundle, must equal the source commit, and cannot be
# changed by runtime relabelling. It is not a runtime secret.
ALBERT_BUILD_SHA=
ALBERT_SERVICE_VERSION=
ALBERT_DEPLOYMENT_ID=

# Connector OAuth registrations. Never expose client secrets to the browser.
# This stays blank until the operator explicitly confirms R-Series rather than
# X-Series; production validation accepts only `r-series` for this V1 pack.
ALBERT_LIGHTSPEED_PRODUCT=
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_WEBHOOK_SIGNING_KEY=
# Independent proof key used to attest verified webhook dispositions to the
# control plane. Install the same 32-byte key through `npm run
# provision:webhook-attestation-key`; never grant the gateway table access.
WEBHOOK_ATTESTATION_KEY_ID=webhook-attestation-v1
WEBHOOK_ATTESTATION_SECRET=
# Tenant-neutral Xero inbox encryption. Generate exactly 32 random bytes and
# encode them as unpadded base64url. This key is independent from OAuth and
# Deputy webhook material. During rotation, retain up to four decrypt-only old
# keys in a JSON object, for example {"xero-inbox-v1":"..."}.
WEBHOOK_INBOX_ENCRYPTION_KEY=
WEBHOOK_INBOX_ENCRYPTION_KEY_ID=xero-inbox-v1
WEBHOOK_INBOX_PREVIOUS_ENCRYPTION_KEYS=
WEBHOOK_INBOX_ENCRYPTED_RETENTION_DAYS=3
WEBHOOK_INBOX_METADATA_RETENTION_DAYS=14
WEBHOOK_INBOX_PERSISTENCE_TIMEOUT_MS=3500
WEBHOOK_INBOX_LEASE_SECONDS=90
WEBHOOK_INBOX_POLL_MS=500
WEBHOOK_INBOX_MAX_ATTEMPTS=12
WEBHOOK_INBOX_RETRY_BASE_SECONDS=5
WEBHOOK_INBOX_RETRY_MAX_SECONDS=3600
# Starter is 1000; Core and higher tiers are 5000. This drives the durable
# per-organisation daily request budget and must match the Xero app tier.
XERO_DAILY_REQUEST_LIMIT=1000
# Requires Xero Advanced tier plus initial and annual approval.
XERO_ENABLE_ADVANCED_JOURNALS=false
DEPUTY_CLIENT_ID=
DEPUTY_CLIENT_SECRET=
# Distinct 256-bit base64url KEK used by the webhook gateway and a separately
# authorized owner/operator installation procedure. It is not loaded by the
# sync/OAuth runtime and must never equal TOKEN_ENCRYPTION_KEY.
DEPUTY_WEBHOOK_ENCRYPTION_KEY=
DEPUTY_WEBHOOK_ENCRYPTION_KEY_ID=deputy-webhook-v1
# During rotation, retain up to four decrypt-only old keys as a JSON object,
# for example {"deputy-webhook-v1":"..."}. Rotation never writes to Deputy.
DEPUTY_WEBHOOK_PREVIOUS_ENCRYPTION_KEYS=
DEPUTY_WEBHOOK_MAX_SKEW_SECONDS=300

# One-time administrator inputs for `npm run provision:runtime-logins`. These
# values belong in an ephemeral operator secret context, not routine services.
CONTROL_PLANE_ADMIN_DATABASE_URL=
ANALYTICAL_ADMIN_DATABASE_URL=
# Shared 32-64 byte HMAC key installed verifier-first in the analytical cell,
# then in the control-plane signer. Generate canonical padded base64 with
# `openssl rand -base64 32`. This secret is provisioning-only and must never be
# configured on Sites, Fly, or any runtime process.
ANALYTICAL_CAPABILITY_KEY_ID=analytical-capability-v1
ANALYTICAL_CAPABILITY_SECRET_BASE64=
ANALYTICAL_CAPABILITY_ACTIVE_AT=
ANALYTICAL_CAPABILITY_RETIRE_AT=
# Optional safe rotation drain. Set both or neither; use a new key id for every
# new secret. The provisioner retires the control signer before the verifier.
ANALYTICAL_CAPABILITY_PREVIOUS_KEY_ID=
ANALYTICAL_CAPABILITY_PREVIOUS_RETIRE_AT=
ALBERT_CONTROL_DEPLOYER_DB_PASSWORD=
ALBERT_SYNC_CONTROL_DB_PASSWORD=
ALBERT_TRANSFORM_CONTROL_DB_PASSWORD=
ALBERT_SEMANTIC_CONTROL_DB_PASSWORD=
ALBERT_WEBHOOK_CONTROL_DB_PASSWORD=
ALBERT_DELETION_CONTROL_DB_PASSWORD=
ALBERT_OPERATOR_DIAGNOSTIC_CONTROL_DB_PASSWORD=
ALBERT_ANALYTICAL_DEPLOYER_DB_PASSWORD=
ALBERT_INGEST_DB_PASSWORD=
ALBERT_TRANSFORM_DB_PASSWORD=
ALBERT_SEMANTIC_READ_DB_PASSWORD=
ALBERT_SEMANTIC_METADATA_DB_PASSWORD=
ALBERT_DELETION_DB_PASSWORD=
ALBERT_OPERATOR_DIAGNOSTIC_ANALYTICAL_DB_PASSWORD=
