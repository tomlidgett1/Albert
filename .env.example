# Browser-visible Supabase settings. Production must be a Sydney project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ALBERT_CONTROL_PLANE_PROJECT_REF=
ALBERT_ANALYTICAL_PROJECT_REF=
ALBERT_CONTROL_PLANE_REGION=ap-southeast-2
ALBERT_ANALYTICAL_REGION=ap-southeast-2

# Vercel web runtime. The AU endpoint provides regional storage; the OpenAI
# project must separately be approved for MAM or ZDR before customer data use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://au.api.openai.com/v1
# Optional. Required only when Grok 4.6 is selected. Add the key in this file;
# do not paste it into chat. xAI inference is US-hosted; Albert sends store:false
# and never shows private reasoning.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Optional. Required only when Claude Haiku 4.5 is selected in the V3 model
# picker. Add the key here; do not paste it into chat. Haiku 4.5 uses global
# first-party routing and has no Fast mode. Production additionally requires
# the APP 8 and ZDR approvals below.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ALBERT_MODEL_DATA_RESIDENCY_REGION=au
# Set true only after the production OpenAI project has approved MAM or ZDR.
ALBERT_MODEL_DATA_CONTROL_APPROVED=false
ALBERT_CONVERSATION_RUNTIME=live
ALBERT_ALLOW_FIXTURE_RUNTIME=false
# Candidate wording is not implicitly approved. Leave blank until the product
# owner has reviewed the code-owned contract, then set its exact exported SHA-256.
ALBERT_BLOCKING_QUESTIONS_APPROVED_DIGEST=
ALBERT_OPENAI_TRACING_ENABLED=false
ALBERT_TURN_TIMEOUT_MS=180000
ALBERT_EMBEDDING_TIMEOUT_MS=20000
ALBERT_USER_HASH_SECRET=
ALBERT_PUBLIC_ORIGIN=

# Independent trust-zone secrets (at least 32 random bytes). The web and the
# corresponding service receive only the one secret they share.
ALBERT_OAUTH_STATE_SECRET=
ALBERT_OAUTH_WORKER_SIGNING_SECRET=
# Dedicated HMAC boundary for V3 -> credential-owning ShopifyQL execution.
# Must be 32+ bytes and distinct from every OAuth/semantic signing secret.
ALBERT_SHOPIFYQL_SIGNING_SECRET=
# Dedicated typed Admin GraphQL boundary; never reuse OAuth, ShopifyQL or
# semantic signing material.
ALBERT_SHOPIFY_ADMIN_SIGNING_SECRET=
ALBERT_OPERATOR_DIAGNOSTIC_SIGNING_SECRET=
# Dedicated HMAC boundary for Vercel -> albert-codex-runtime. Must be 32+ bytes
# and distinct from every OAuth, Shopify, operator-diagnostic and user-hash secret.
ALBERT_CODEX_RUNTIME_SIGNING_SECRET=

# HTTPS endpoints for separately deployed services. `npm run dev` on localhost
# uses these same Fly/Supabase origins. Do not point them at Docker, Cubecore,
# or 127.0.0.1. ALBERT_PUBLIC_ORIGIN is the only loopback URL. OAuth and
# semantic routes require HMAC.
SYNC_WORKER_INTERNAL_URL=
# Live Xero reports (P&L, balance sheet, trial balance, aged reports) go to the
# sync worker's /v1/xero-mcp/* on SYNC_WORKER_INTERNAL_URL in every environment,
# localhost included. Set this only to override — e.g. http://127.0.0.1:8791 to
# use the local sidecar from `npm run dev:xero-mcp` while changing the MCP layer.
XERO_MCP_SERVICE_URL=
# Fivetran-managed sources (sync worker only): Xero, Lightspeed Retail
# R-Series (`light_speed_retail`) and Deputy. Fivetran writes each connection
# to its own native destination schema — `xero_<id>`, `lightspeed_<id>`,
# `deputy_<id>` — in the analytical database. Do not invent an Albert source_*
# schema for this path.
#  - Xero: no card. Albert's own Xero OAuth takes the single consent and the
#    worker deploys Albert's Fivetran SDK connector (see below).
#  - Lightspeed R-Series: no card. Albert's own Lightspeed OAuth
#    (LIGHTSPEED_CLIENT_ID/SECRET) takes the single consent and the worker
#    deploys Albert's Fivetran SDK connector (connectors/lightspeed-fivetran-sdk),
#    which lands all 90 ls_* tables in `lightspeed_<id>`.
#  - Deputy: no card. Albert's own Deputy OAuth (DEPUTY_CLIENT_ID/SECRET) takes
#    the grant, the worker hands sub_domain + access token to Fivetran via API,
#    and a 6-hourly relay re-pushes a refreshed token (Deputy tokens expire).
# Leave these blank until the destination group already points at analytics.
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=
# Optional prefix for Fivetran's native Xero tables. Each Albert connection
# gets its own schema `xero_<connection_id>` so tenants never share rows.
# Must start with a letter (5XERO is invalid and would be rewritten to _5xero).
FIVETRAN_XERO_SCHEMA=
# Optional. Postgres role Fivetran uses to create tables in that schema.
FIVETRAN_DESTINATION_ROLE=
# Xero and Lightspeed R-Series run on Albert's own Connector SDK connectors
# (connectors/xero-fivetran-sdk, connectors/lightspeed-fivetran-sdk): the
# customer approves the vendor ONCE, in Albert's own OAuth app, the worker
# packages + deploys the connector to Fivetran per tenant, and the connector
# fetches short-lived tokens from this worker's token broker
# (POST /v1/fivetran/token). The broker URL is this worker's public https
# origin; on Fly it is derived from FLY_APP_NAME, elsewhere set it explicitly.
FIVETRAN_TOKEN_BROKER_ORIGIN=
# Optional: where the SDK projects live inside the worker image, and which
# Python runtime Fivetran should run them on (default 3.12).
FIVETRAN_XERO_SDK_DIR=connectors/xero-fivetran-sdk
FIVETRAN_LIGHTSPEED_SDK_DIR=connectors/lightspeed-fivetran-sdk
FIVETRAN_SDK_PYTHON_VERSION=
# Production Cube on Fly (local Docker is not used for web iteration).
CUBE_API_URL=https://albert-cube.fly.dev
CUBEJS_API_SECRET=
# Isolated Codex analytics runtime on Fly (local Docker is not used).
CODEX_RUNTIME_SERVICE_URL=https://albert-codex-runtime.fly.dev

OPERATOR_DIAGNOSTIC_SERVICE_URL=
WEBHOOK_GATEWAY_PUBLIC_URL=

# Process-specific database URLs. Deployments may use the same variable name,
# but each value must contain the dedicated NOINHERIT login documented below.
# sync:      albert_sync_control_runtime -> albert_sync_control
# webhook:   albert_webhook_control_runtime -> albert_webhook_control
# semantic:  albert_semantic_control_runtime -> albert_semantic_control
# anthropic: albert_anthropic_control_runtime -> albert_anthropic_control
# deletion:  albert_deletion_control_runtime -> albert_deletion_control
CONTROL_PLANE_DATABASE_URL=
# sync: albert_ingest_runtime -> ingest_rw
# semantic: albert_semantic_read_runtime -> semantic_ro
ANALYTICAL_DATABASE_URL=
# transform control and analytical logins are deliberately named separately.
# semantic metadata is a second analytical login, member only of semantic_meta_rw.
# Claude Agent SDK session storage only; no analytical database grants.

# Historical isolated Anthropic analytics provider settings. These do not
# change the V3 Haiku transport above; a future service activation still needs
# an approved ap-southeast-2 Bedrock profile and exact Opus/Sonnet support.
ALBERT_ANTHROPIC_PROVIDER=direct
ALBERT_ANTHROPIC_BEDROCK_MODEL=
ALBERT_ANTHROPIC_BEDROCK_FALLBACK_MODEL=
ALBERT_ANTHROPIC_APP8_APPROVED=false
ALBERT_ANTHROPIC_ZDR_APPROVED=false
ALBERT_ANTHROPIC_LOAD_TEST_APPROVED=false
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ALBERT_LIGHTSPEED_TABLE_CATALOGUE=connectors/lightspeed-r/tables.json
# deletion analytical login, member only of deletion_rw.
DELETION_ANALYTICAL_DATABASE_URL=
# Dedicated operator diagnostic URLs. These credentials belong only to the
# signed row-sample service and must never be configured in Sites.
OPERATOR_DIAGNOSTIC_CONTROL_PLANE_DATABASE_URL=
OPERATOR_DIAGNOSTIC_ANALYTICAL_DATABASE_URL=

# Mandatory production relay to the independently deployed live-vendor
# attestor. Local development may set the toggle to false; production rejects
# false. The origin must be the clean private Fly .internal HTTPS origin, and
# the server name must exactly equal its hostname. Store the three PEM values
# as standard base64 and give only this client certificate/key to sync workers.
ALBERT_VENDOR_ATTESTOR_RELAY_ENABLED=false
ALBERT_VENDOR_ATTESTOR_PRIVATE_ORIGIN=
ALBERT_VENDOR_ATTESTOR_TLS_SERVER_NAME=
ALBERT_VENDOR_ATTESTOR_EXPECTED_TOOL_REF=
ALBERT_VENDOR_ATTESTOR_EXPECTED_BUILD_DIGEST=
ALBERT_VENDOR_ATTESTOR_TLS_CLIENT_CERT_BASE64=
ALBERT_VENDOR_ATTESTOR_TLS_CLIENT_KEY_BASE64=
ALBERT_VENDOR_ATTESTOR_TLS_SERVER_CA_BASE64=
ALBERT_VENDOR_ATTESTOR_RELAY_POLL_MS=1000

# Immutable production release authority. The ref, tooling SHA, and workflow
# ref are non-secret protected-environment values and must identify the same
# signed annotated albert-release-authority-v* tag. The signer email is a
# repository/organisation variable because the credential-free build job has
# no GitHub environment; dogfood-staging also pins that email. The private
# receipt key is production-authorizer-only;
# downstream protected jobs receive only the matching public key.
ALBERT_RELEASE_AUTHORITY_REF=
ALBERT_RELEASE_AUTHORITY_TOOLING_SHA=
ALBERT_RELEASE_AUTHORITY_WORKFLOW_REF=
ALBERT_RELEASE_AUTHORITY_SIGNER_EMAIL=
ALBERT_RELEASE_AUTHORITY_CREATOR_APP_ID=
# Configuration-audit credential stored separately in production and
# vendor-attestor-trust: Metadata(read)+Actions(read) on a non-dispatcher audit
# principal with administrator visibility. Provisioning must prove that GitHub
# returns ruleset bypass_actors; the workflow never uses mutation endpoints.
ALBERT_GITHUB_CONFIGURATION_AUDIT_TOKEN=
ALBERT_RELEASE_AUTHORIZATION_ED25519_PRIVATE_KEY_BASE64URL=
ALBERT_RELEASE_AUTHORIZATION_ED25519_PUBLIC_KEY_BASE64URL=

# Workflow-provided coordinates. These are shown for tooling completeness but
# are dispatch inputs or generated outputs; do not persist them as protected
# environment configuration and never choose a dogfood artifact by "latest".
ALBERT_RELEASE_ENVIRONMENT=
ALBERT_RELEASE_CANDIDATE_SHA=
ALBERT_RELEASE_COMMIT_SHA=
ALBERT_DOGFOOD_RUN_ID=
ALBERT_DOGFOOD_ARTIFACT_ID=
ALBERT_DOGFOOD_ARTIFACT_DIGEST=
ALBERT_DOGFOOD_CANDIDATE_SHA=
ALBERT_DOGFOOD_ONBOARDING_JOURNEY_ID=
ALBERT_RELEASE_PLAN_DIGEST=
ALBERT_RELEASE_SERVICES_IMAGE=
ALBERT_RELEASE_GITHUB_AUTHORITY_AUDIT_DIGEST=
ALBERT_RELEASE_REVIEWER_ID=
ALBERT_RELEASE_REVIEWER_LOGIN=
ALBERT_RELEASE_APPROVAL_RECORD_DIGEST=
ALBERT_RELEASE_AUTHORITY_ROOT=
ALBERT_RELEASE_CANDIDATE_ROOT=
ALBERT_RELEASE_CI_WORKFLOW_ID=
ALBERT_RELEASE_CI_RUN_ID=
ALBERT_RELEASE_CI_RUN_ATTEMPT=
ALBERT_RELEASE_CI_CHECK_SUITE_ID=
ALBERT_DOGFOOD_ACCEPTANCE_EVIDENCE=
ALBERT_TRANSFORM_FLEET_CAPACITY_ATTESTATION_BASE64=
ALBERT_REQUIRE_DEPLOYER_LOGIN=
ALBERT_RELEASE_READINESS_ATTEMPTS=12
ALBERT_RELEASE_READINESS_DELAY_MS=5000
# Optional alternative to --sites-inventory-names for the local audit command.
ALBERT_SITES_ENVIRONMENT_NAMES_FILE=

# Exact trusted dogfood producer pins stored in dogfood-staging. Production
# derives the expected producer ref/SHA from its own authority event and accepts
# only the explicit candidate/run/artifact coordinates above.
ALBERT_DOGFOOD_ACCEPTANCE_WORKFLOW_REF=
ALBERT_DOGFOOD_TRUSTED_TOOLING_SHA=
# Production verifier material and one-use ledger URL.
ALBERT_DOGFOOD_ACCEPTANCE_ED25519_PUBLIC_KEY_BASE64URL=
ALBERT_DOGFOOD_CONTROL_DATABASE_URL=
# Release-only authenticated Cube proof. The URL must be the exact
# albert_operator_diagnostic_control_runtime login against the production
# control cell, never the staging dogfood cell. The tenant is a dedicated,
# non-customer production smoke tenant with an active owner.
ALBERT_RELEASE_CUBE_SMOKE_CONTROL_DATABASE_URL=
ALBERT_RELEASE_CUBE_SMOKE_TENANT_ID=

# Protected dogfood-staging producer inputs. Identifiers, plans, and HMAC/key
# material are still sensitive even when their names are not; keep every value
# blank in source control. The production authority receives only the public
# verifier/ledger input above plus the explicit run/artifact coordinates.
ALBERT_DOGFOOD_ACCEPTANCE_ED25519_PRIVATE_KEY_BASE64URL=
ALBERT_DOGFOOD_PUBLIC_ORIGIN=
ALBERT_DOGFOOD_ONBOARDING_RECIPIENT_RSA_PUBLIC_KEY_BASE64URL=
ALBERT_DOGFOOD_CATEGORY_ARTIFACT_ID=
ALBERT_DOGFOOD_DEPUTY_CONNECTION_ID=
ALBERT_DOGFOOD_DISCONNECT_PROOF_ID=
ALBERT_DOGFOOD_FLAGSHIP_ARTIFACT_ID=
ALBERT_DOGFOOD_FLY_READONLY_TOKEN=
ALBERT_DOGFOOD_LIGHTSPEED_CONNECTION_ID=
ALBERT_DOGFOOD_ONBOARDING_TENANT_ID=
ALBERT_DOGFOOD_REFERENCE_HMAC_KEY_BASE64URL=
ALBERT_DOGFOOD_SEMANTIC_CASE_PLAN_JSON=
ALBERT_DOGFOOD_SEMANTIC_SIGNING_SECRET=
ALBERT_DOGFOOD_TENANT_DELETION_PROOF_ID=
ALBERT_DOGFOOD_TENANT_ID=
ALBERT_DOGFOOD_XERO_CONNECTION_ID=
ALBERT_DOGFOOD_CATEGORY_TOPIC=
ALBERT_DOGFOOD_DEPLOYMENT_ID=
ALBERT_DOGFOOD_ONBOARDING_TARGET_MINUTES=
ALBERT_DOGFOOD_RUNTIME_PROBES_JSON=
ALBERT_DOGFOOD_SEMANTIC_QUERY_URL=

# Local recipient-only decryption input. Never place this private key in a
# GitHub environment, workflow artifact, Sites, or Fly runtime.
ALBERT_DOGFOOD_ONBOARDING_RECIPIENT_RSA_PRIVATE_KEY_BASE64URL=

# Protected release/migration credentials and the explicit Fly targets used by
# staging and production. Every token/key/URL remains blank here intentionally.
CONTROL_PLANE_MIGRATION_URL=
ANALYTICAL_MIGRATION_URL=
SUPABASE_MANAGEMENT_TOKEN=
FLY_ORGANIZATION_SLUG=
FLY_SEMANTIC_APP=
FLY_SYNC_APP=
FLY_TRANSFORM_APP=
FLY_WEBHOOK_APP=
FLY_DELETION_APP=
FLY_OPERATOR_DIAGNOSTIC_APP=
FLY_SYNC_AUTOSCALER_APP=
FLY_TRANSFORM_AUTOSCALER_APP=
FLY_SEMANTIC_API_TOKEN=
FLY_SYNC_API_TOKEN=
FLY_TRANSFORM_API_TOKEN=
FLY_WEBHOOK_API_TOKEN=
FLY_DELETION_API_TOKEN=
FLY_OPERATOR_DIAGNOSTIC_API_TOKEN=
FLY_SYNC_AUTOSCALER_API_TOKEN=
FLY_TRANSFORM_AUTOSCALER_API_TOKEN=
FLY_SYNC_SCALING_TOKEN=
FLY_TRANSFORM_SCALING_TOKEN=
FLY_PROMETHEUS_READ_TOKEN=
ALBERT_SNAPSHOT_P95_MS=

# Isolated staging-capacity environment used only by immutable production
# authority. It has separate databases, Fly apps, deploy/scaling credentials,
# and no production runtime credentials.
ALBERT_CAPACITY_ATTESTOR_URL=
ALBERT_CAPACITY_CONTROL_PLANE_PROJECT_REF=
FLY_TRANSFORM_CAPACITY_APP=
FLY_TRANSFORM_CAPACITY_AUTOSCALER_APP=
FLY_CAPACITY_ORG_API_TOKEN=
FLY_TRANSFORM_CAPACITY_SCALING_TOKEN=
CAPACITY_CONTROL_PLANE_MIGRATION_URL=
CAPACITY_ANALYTICAL_MIGRATION_URL=
CAPACITY_TRANSFORM_CONTROL_PLANE_DATABASE_URL=
CAPACITY_TRANSFORM_DATABASE_URL=
ALBERT_CAPACITY_ED25519_PUBLIC_KEY_BASE64=

# Workflow-derived capacity-harness values. The protected workflow computes
# these for one run; do not persist them in a GitHub environment.
ALBERT_CAPACITY_RUN_ID=
ALBERT_CAPACITY_RUN_APPROVED=
ALBERT_CAPACITY_RESET_APPROVED=
ALBERT_CAPACITY_MIN_SAMPLES=500
ALBERT_CAPACITY_MAX_CLAIMS=
ALBERT_CAPACITY_NOT_BEFORE=
ALBERT_CAPACITY_HOLD_UNTIL=

# Independent capacity-attestor contract. The allowed identity, observer
# endpoints, and private credentials belong only in the trust deployment; the
# production verifier separately receives the public key plus the pinned cell,
# corpus, tool ref, and build digest. None belongs in Sites, an Albert runtime,
# or candidate release CI. See docs/independent-capacity-attestor.md.
ALBERT_CAPACITY_ALLOWED_REPOSITORY=
ALBERT_CAPACITY_ALLOWED_WORKFLOW_REF=
ALBERT_CAPACITY_ALLOWED_AUTHORITY_REF=
ALBERT_CAPACITY_ALLOWED_AUTHORITY_SHA=
ALBERT_CAPACITY_STAGING_CELL_ID=
ALBERT_CAPACITY_TRANSFORM_APP=
ALBERT_CAPACITY_AUTOSCALER_APP=
ALBERT_CAPACITY_REQUESTED_FLOOR=2
ALBERT_CAPACITY_CORPUS_FINGERPRINT=
ALBERT_CAPACITY_ATTESTOR_TOOL_REF=
ALBERT_CAPACITY_ATTESTOR_BUILD_DIGEST=
ALBERT_CAPACITY_PROMETHEUS_ORIGIN=
ALBERT_CAPACITY_PROMETHEUS_RUNNING_QUERY=
ALBERT_CAPACITY_PROMETHEUS_DESIRED_QUERY=
ALBERT_CAPACITY_ED25519_PRIVATE_KEY_BASE64=
ALBERT_CAPACITY_ATTESTOR_STORE_DATABASE_URL=
ALBERT_CAPACITY_CONTROL_OBSERVER_DATABASE_URL=
ALBERT_CAPACITY_ANALYTICAL_OBSERVER_DATABASE_URL=
ALBERT_CAPACITY_GITHUB_READ_TOKEN=
ALBERT_CAPACITY_FLY_READ_TOKEN=
ALBERT_CAPACITY_PROMETHEUS_READ_TOKEN=

# Independent live-vendor attestor trust deployment. The vendor-attestor-trust
# workflow derives TOOL_REF and BUILD_DIGEST from the reviewed authority SHA and
# pushed image; they remain pinned runtime values. Private signing/TLS material,
# the admission key, database URL/password, and Fly token never belong in an
# Albert runtime, Sites, or a candidate release job.
ALBERT_VENDOR_ATTESTOR_AUTHORITY_SHA=
ALBERT_VENDOR_ATTESTOR_TAG_SIGNER_EMAIL=
ALBERT_VENDOR_ATTESTOR_TAG_ISSUER_APP_ID=
FLY_VENDOR_ATTESTOR_APP=
FLY_VENDOR_ATTESTOR_API_TOKEN=
ALBERT_VENDOR_ATTESTOR_DATABASE_URL=
ALBERT_VENDOR_ATTESTOR_DB_PASSWORD=
ALBERT_VENDOR_ATTESTOR_ED25519_PRIVATE_KEY_BASE64=
ALBERT_VENDOR_ATTESTOR_ED25519_PUBLIC_KEY_BASE64=
ALBERT_VENDOR_ATTESTOR_ADMISSION_HMAC_KEY_BASE64=
ALBERT_VENDOR_ATTESTOR_TLS_KEY_BASE64=
ALBERT_VENDOR_ATTESTOR_TLS_CERT_BASE64=
ALBERT_VENDOR_ATTESTOR_TLS_CLIENT_CA_BASE64=
ALBERT_VENDOR_ATTESTOR_KEY_ID=
ALBERT_VENDOR_ATTESTOR_TOOL_REF=
ALBERT_VENDOR_ATTESTOR_BUILD_DIGEST=
ALBERT_VENDOR_ATTESTOR_SYNC_CLIENT_SHA256=

# Deployment-only semantic publisher. Never configure this role in a runtime.
ALBERT_SEMANTIC_PUBLISH_ROLE=albert_control_migration_owner

# Supabase Storage S3 session coordinates. Generated S3 key pairs are forbidden:
# they bypass RLS. In production the access key ID is the project ref and the
# secret key is the legacy anon JWT (publishable keys are not S3-compatible).
# Each service receives only its own protected machine password; the provider
# exchanges it for a short-lived JWT and refreshes that session in memory.
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_S3_REGION=ap-southeast-2
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_LEGACY_ANON_KEY=
ALBERT_RAW_STORAGE_SYNC_PASSWORD=
ALBERT_RAW_STORAGE_WEBHOOK_PASSWORD=
ALBERT_RAW_STORAGE_DELETION_PASSWORD=

# Protected release provisioner only. Never stage these names in Sites or Fly.
SUPABASE_AUTH_URL=
SUPABASE_AUTH_ADMIN_SERVICE_ROLE_KEY=
ALBERT_RAW_STORAGE_CREDENTIAL_GENERATION=

# Stable worker role identities. Every service automatically appends Fly's
# machine ID; non-Fly orchestrators must set ALBERT_WORKER_INSTANCE_ID uniquely
# per replica so lease fencing remains safe when services scale horizontally.
ALBERT_WORKER_ID=
ALBERT_WORKER_INSTANCE_ID=
ALBERT_WORKER_CONCURRENCY=8
ALBERT_QUEUE_SLA_SECONDS=300
ALBERT_METRICS_PORT=9091
ALBERT_MAPPING_VERSION=m2-v1
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=
# Optional decrypt-only overlap keyring shared by sync/OAuth and deletion
# runtimes during KEK rotation. Canonical JSON, at most four distinct entries:
# {"token-v1":"<canonical-unpadded-base64url-32-byte-key>"}
TOKEN_PREVIOUS_ENCRYPTION_KEYS=

# Transform worker identity.
ALBERT_TRANSFORM_WORKER_ID=
# Transform deployments use the same bounded concurrency/metrics settings,
# with a 120-second queue SLO and a drain-to-empty hourly tenant sweep.
ALBERT_SNAPSHOT_CLAIM_BATCH_SIZE=8
ALBERT_SNAPSHOT_MAX_CLAIMS_PER_RUN=20000

# Semantic promotion relay identity and bounded recovery controls. The source
# exploration request returns only after the corresponding inbox delivery is
# durably acknowledged; this loop recovers outbox rows after process loss.
ALBERT_SEMANTIC_RELAY_WORKER_ID=semantic-promotion-relay
ALBERT_SEMANTIC_RELAY_POLL_INTERVAL_MS=5000
ALBERT_SEMANTIC_RELAY_TENANT_BATCH_SIZE=10
ALBERT_SEMANTIC_RELAY_CANDIDATE_BATCH_SIZE=20
ALBERT_SEMANTIC_RELAY_LEASE_SECONDS=90

# Public webhook gateway background processor role identity.
ALBERT_WEBHOOK_WORKER_ID=

# Deletion worker identity and proof-authentication key.
ALBERT_DELETION_WORKER_ID=
DELETION_PROOF_HMAC_KEY=
DELETION_WORKER_POLL_MS=1000

# Non-secret deployment identity set automatically by the release workflow.
# ALBERT_BUILD_SHA is a build input for Sites and Fly service images. It is
# compiled into every bundle, must equal the source commit, and cannot be
# changed by runtime relabelling. It is not a runtime secret.
ALBERT_BUILD_SHA=
ALBERT_SERVICE_VERSION=
ALBERT_DEPLOYMENT_ID=

# Connector OAuth registrations. Never expose client secrets to the browser.
# This stays blank until the operator explicitly confirms R-Series rather than
# X-Series; production validation accepts only `r-series` for this V1 pack.
ALBERT_LIGHTSPEED_PRODUCT=
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
# X-Series is a separate API product and OAuth registration. Keep this blank
# until the connector is deliberately admitted; production accepts only the
# exact `x-series` marker when LIGHTSPEED_X_CLIENT_ID is configured.
ALBERT_LIGHTSPEED_X_PRODUCT=
LIGHTSPEED_X_CLIENT_ID=
LIGHTSPEED_X_CLIENT_SECRET=
XERO_CLIENT_ID=
# Square OAuth (confidential code flow). The application ID is needed by
# both the web app and the sync worker; the secret only ever reaches the
# worker, which owns the token exchange and revocation. A sandbox-sq0idb-
# application ID selects Square's sandbox connect host.
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# Shopify. The shop domain is supplied per connection by the merchant, so only
# the app credentials live here. The secret also verifies the callback HMAC, so
# the web app needs it as well as the worker.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# App-specific Shopify webhooks must target
# /v1/webhooks/shopify/compliance. This one always-on endpoint admits only
# customers/data_request, customers/redact, shop/redact, and app/uninstalled;
# operational webhooks remain disabled until manual ingestion activation.
# Stripe Connect. STRIPE_SECRET_KEY is the platform's own secret key: Stripe
# deprecated per-connection tokens, so it authorises both the OAuth exchange
# and later Stripe-Account requests.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
# Momence OAuth. The public client id is used by the web authorization route;
# the secret remains worker-only for the token exchange. A successful consent
# stores authorization but never imports data until Start ingestion is chosen.
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
XERO_WEBHOOK_SIGNING_KEY=
# Independent proof key used to attest verified webhook dispositions to the
# control plane. Install the same 32-byte key through `npm run
# provision:webhook-attestation-key`; never grant the gateway table access.
WEBHOOK_ATTESTATION_KEY_ID=webhook-attestation-v1
WEBHOOK_ATTESTATION_SECRET=
# Tenant-neutral Xero inbox encryption. Generate exactly 32 random bytes and
# encode them as unpadded base64url. This key is independent from OAuth and
# Deputy webhook material. During rotation, retain up to four decrypt-only old
# keys in a JSON object, for example {"xero-inbox-v1":"..."}.
WEBHOOK_INBOX_ENCRYPTION_KEY=
WEBHOOK_INBOX_ENCRYPTION_KEY_ID=xero-inbox-v1
WEBHOOK_INBOX_PREVIOUS_ENCRYPTION_KEYS=
WEBHOOK_INBOX_ENCRYPTED_RETENTION_DAYS=3
WEBHOOK_INBOX_METADATA_RETENTION_DAYS=14
WEBHOOK_INBOX_PERSISTENCE_TIMEOUT_MS=3500
WEBHOOK_INBOX_LEASE_SECONDS=90
WEBHOOK_INBOX_POLL_MS=500
WEBHOOK_INBOX_MAX_ATTEMPTS=12
WEBHOOK_INBOX_RETRY_BASE_SECONDS=5
WEBHOOK_INBOX_RETRY_MAX_SECONDS=3600
# Starter is 1000; Core and higher tiers are 5000. This drives the durable
# per-organisation daily request budget and must match the Xero app tier.
XERO_DAILY_REQUEST_LIMIT=1000
# Requires Xero Advanced tier plus initial and annual approval.
XERO_ENABLE_ADVANCED_JOURNALS=false
# Comma-separated connector ids accepted by the sync-worker provider registry
# that should authorise and store credentials without enqueuing an initial
# backfill. Manual-start packs such as Momence already wait for explicit user
# activation; this switch is an additional operational block. Unknown ids fail
# worker startup.
ALBERT_OAUTH_SUPPRESS_INITIAL_BACKFILL=
DEPUTY_CLIENT_ID=
DEPUTY_CLIENT_SECRET=
# Distinct 256-bit base64url KEK used by the webhook gateway and a separately
# authorized owner/operator installation procedure. It is not loaded by the
# sync/OAuth runtime and must never equal TOKEN_ENCRYPTION_KEY.
DEPUTY_WEBHOOK_ENCRYPTION_KEY=
DEPUTY_WEBHOOK_ENCRYPTION_KEY_ID=deputy-webhook-v1
# During rotation, retain up to four decrypt-only old keys as a JSON object,
# for example {"deputy-webhook-v1":"..."}. Rotation never writes to Deputy.
DEPUTY_WEBHOOK_PREVIOUS_ENCRYPTION_KEYS=
DEPUTY_WEBHOOK_MAX_SKEW_SECONDS=300

# One-time administrator inputs for `npm run provision:runtime-logins`. These
# values belong in an ephemeral operator secret context, not routine services.
CONTROL_PLANE_ADMIN_DATABASE_URL=
ANALYTICAL_ADMIN_DATABASE_URL=
# Shared 32-64 byte HMAC key installed verifier-first in the analytical cell,
# then in the control-plane signer. Generate canonical padded base64 with
# `openssl rand -base64 32`. This secret is provisioning-only and must never be
# configured on Sites, Fly, or any runtime process.
ANALYTICAL_CAPABILITY_KEY_ID=analytical-capability-v1
ANALYTICAL_CAPABILITY_SECRET_BASE64=
ANALYTICAL_CAPABILITY_ACTIVE_AT=
ANALYTICAL_CAPABILITY_RETIRE_AT=
# Optional safe rotation drain. Set both or neither; use a new key id for every
# new secret. The provisioner retires the control signer before the verifier.
ANALYTICAL_CAPABILITY_PREVIOUS_KEY_ID=
ANALYTICAL_CAPABILITY_PREVIOUS_RETIRE_AT=
ALBERT_CONTROL_DEPLOYER_DB_PASSWORD=
ALBERT_SYNC_CONTROL_DB_PASSWORD=
ALBERT_TRANSFORM_CONTROL_DB_PASSWORD=
ALBERT_SEMANTIC_CONTROL_DB_PASSWORD=
ALBERT_ANTHROPIC_CONTROL_DB_PASSWORD=
ALBERT_WEBHOOK_CONTROL_DB_PASSWORD=
ALBERT_DELETION_CONTROL_DB_PASSWORD=
ALBERT_OPERATOR_DIAGNOSTIC_CONTROL_DB_PASSWORD=
ALBERT_ANALYTICAL_DEPLOYER_DB_PASSWORD=
ALBERT_INGEST_DB_PASSWORD=
ALBERT_TRANSFORM_DB_PASSWORD=
ALBERT_SEMANTIC_READ_DB_PASSWORD=
ALBERT_SEMANTIC_METADATA_DB_PASSWORD=
ALBERT_DELETION_DB_PASSWORD=
ALBERT_OPERATOR_DIAGNOSTIC_ANALYTICAL_DB_PASSWORD=
# Server-owned turn route. Keep v1 until V2 qualification and the controlled global cutover.
ALBERT_ANALYTICAL_RUNTIME=v1
ALBERT_SEMANTIC_V2_PUBLICATION_HASH=
# Required only for the one-shot 200-case V2 release evaluation. Keep the
# sealed 40-case holdout outside the repository.
ALBERT_V2_EVALUATION_HOLDOUT_PATH=
# Keep dataset-bound deterministic gold outside the repository as well. It
# must cover every answerable lookup and comparison in the sealed corpus.
ALBERT_V2_EVALUATION_GOLD_PATH=
# Exact passed deterministic-qualification receipt for the same commit and
# publication. The model runner verifies its live staging-schema audit before
# reserving the one-shot 200-case budget.
ALBERT_V2_DETERMINISTIC_RECEIPT_PATH=
