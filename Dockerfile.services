# syntax=docker/dockerfile:1.7

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build
ARG ALBERT_BUILD_SHA=development
ENV ALBERT_BUILD_SHA=$ALBERT_BUILD_SHA
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=albert-services-build-npm,target=/root/.npm,sharing=locked npm ci
COPY . .
RUN npm run build:services

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime
ARG ALBERT_BUILD_SHA=development
LABEL org.opencontainers.image.revision=$ALBERT_BUILD_SHA
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=albert-services-runtime-npm,target=/root/.npm,sharing=locked npm ci --omit=dev --ignore-scripts \
  && npm cache clean --force
COPY --from=build --chown=node:node /workspace/.albert-build/services ./services
COPY --from=build --chown=node:node /workspace/connectors/lightspeed-r/tables.json ./connectors/lightspeed-r/tables.json
USER node

# Deployments override this command for sync-worker.js,
# deletion-worker.js, webhook-gateway.js, operator-diagnostic.js, and
# transform-capacity-harness.js entry is operator-invoked only; it is never a
# long-running process or an HTTP surface.
CMD ["node", "--enable-source-maps", "services/sync-worker.js"]
