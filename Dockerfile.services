# syntax=docker/dockerfile:1.7

FROM node:22.23.1-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY . .
RUN npm run build:services

FROM node:22.23.1-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts \
  && npm cache clean --force
COPY --from=build --chown=node:node /workspace/.albert-build/services ./services
COPY --from=build --chown=node:node /workspace/packages/semantic-registry/registry ./packages/semantic-registry/registry
USER node

# Deployments override this command for sync-worker.js, transform-worker.js,
# deletion-worker.js, and webhook-gateway.js.
CMD ["node", "--enable-source-maps", "services/semantic-query.js"]
